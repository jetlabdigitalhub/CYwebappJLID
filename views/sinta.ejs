<%- include("partials/head", { pageTitle }) %>
<link rel="stylesheet" href="/css/sinta.css">
<section class="page-heading sinta-heading"><div><p class="eyebrow">Riset jurnal</p><h1>SINTA Journal Scraper</h1><p class="muted">Cari jurnal dari SINTA, rapikan hasilnya, lalu unduh data yang sedang kamu lihat.</p></div><a class="button button-secondary" href="/">← Dashboard</a></section>
<div id="sinta-error" class="error-banner" role="alert"></div>
<form id="sinta-form" class="sinta-layout"><div class="sinta-toolbar"><section class="panel sinta-section"><p class="eyebrow">Input pencarian</p><h2>Search Queries</h2><div id="query-list" class="query-list"></div><div class="query-add"><input id="query-input" type="text" placeholder="Tambahkan query, misalnya English"><button class="button button-secondary" id="add-query" type="button">+ Tambah Query</button></div><div class="query-paste"><label for="query-paste-input">Atau tempel beberapa query sekaligus</label><textarea id="query-paste-input" placeholder="English&#10;Linguistics&#10;Applied Linguistics"></textarea></div></section><section class="panel sinta-section"><p class="eyebrow">Kontrol</p><h2>Scraping Options</h2><div class="options-grid"><div><span class="field-label">Pages</span><div class="radio-row"><label><input type="radio" name="mode" value="test" checked> Test - 1 page</label><label><input type="radio" name="mode" value="all"> All pages</label><label><input type="radio" name="mode" value="custom"> Custom</label><input class="custom-pages" id="custom-pages" type="number" min="1" max="500" value="5"></div></div><label><span class="field-label">Request delay</span><span class="delay-field"><input id="request-delay" type="number" min="0" max="30000" value="1000"><span class="muted">ms</span></span></label><button class="button" id="start-scraping" type="submit">⌕ Start Scraping</button></div></section></div><section class="panel sinta-section progress-card" id="progress-card"><p class="eyebrow">Live status</p><h2>Scraping Progress</h2><div class="progress-meta"><strong id="progress-query">Menyiapkan...</strong><span id="progress-page">Page 0 / 1</span></div><div class="progress-track"><div class="progress-value" id="progress-value" style="width:0%"></div></div><p class="status-message" id="progress-status">Menunggu scraping dimulai.</p></section></form>
<section class="panel sinta-section progress-card" id="results-card"><div class="panel-heading"><div><p class="eyebrow">Hasil</p><h2>Journal Results</h2></div><button class="button" id="download-xlsx" type="button">↓ Download XLSX</button></div><div class="summary-grid"><div class="summary-item"><strong id="total-results">0</strong><span>Unique journals</span></div><div class="summary-item"><strong id="raw-results">0</strong><span>Raw records</span></div><div class="summary-item"><strong id="duplicate-results">0</strong><span>Duplicates removed</span></div></div><div class="result-controls"><div class="results-search"><input id="result-search" type="search" placeholder="Search journals, affiliation, ISSN..."></div><select class="option-select" id="rank-filter"><option value="">SINTA Rank: All</option><option>S1</option><option>S2</option><option>S3</option><option>S4</option><option>S5</option><option>S6</option></select><select class="option-select" id="scopus-filter"><option value="">Scopus: All</option><option>Yes</option><option>No</option></select><select class="option-select" id="garuda-filter"><option value="">Garuda: All</option><option>Yes</option><option>No</option></select><select class="option-select" id="subject-filter"><option value="">Subject: All</option></select></div><p class="result-count" id="result-count">0 results</p><div class="table-wrap"><table class="sinta-table"><thead><tr><th>Journal</th><th>SINTA</th><th>P-ISSN</th><th>E-ISSN</th><th>Affiliation</th><th>Subject Area</th><th>Scopus</th><th>Garuda</th><th>Impact</th><th>H5 Index</th><th>Citations 5yr</th><th>Matched Queries</th></tr></thead><tbody id="results-body"></tbody></table><div class="empty-results" id="empty-results">Belum ada hasil yang cocok.</div></div><div id="failure-list" class="failure-list" hidden></div></section>
<script src="/js/sinta.js"></script><%- include("partials/footer") %>